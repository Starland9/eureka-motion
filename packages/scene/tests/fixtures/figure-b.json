{
  "language": "fr",
  "payload": {
    "version": 1,
    "plan": {
      "objective": "Savoir lire et construire les figures de base de la physique et de la géométrie : forces, cotes, angles.",
      "prerequisites": [
        "Savoir tracer une flèche pour une force",
        "Connaître le triangle rectangle"
      ],
      "analogy": {
        "name": "La planche de manuel",
        "mapping": "Chaque trait de la figure joue le rôle d'une grandeur : une flèche pour une force, une cote pour une longueur, un arc pour un angle."
      },
      "key_rule": {
        "statement": "Sur un plan incliné à l'équilibre, la réaction normale vaut P cos α et le frottement P sin α.",
        "formula": "\\a{f} = \\a{P} \\sin \\q{\\alpha}"
      },
      "steps": [
        {
          "role": "mechanism",
          "intent": "Montrer les trois forces sur un bloc posé sur un plan incliné.",
          "visual": "Un plan incliné, un bloc, trois flèches et l'angle de la pente."
        },
        {
          "role": "example",
          "intent": "Lire les trois côtés et les angles d'un triangle rectangle.",
          "visual": "Un triangle rectangle coté sur ses trois côtés."
        },
        {
          "role": "recap",
          "intent": "Comparer un cercle et deux points à distance.",
          "visual": "Un disque avec rayon et secteur hachuré, deux points et leur cote."
        }
      ]
    },
    "params": [
      {
        "id": "alpha",
        "symbol": "α",
        "label": "Angle du plan",
        "unit": "°",
        "min": 25,
        "max": 40,
        "step": 1,
        "default": 30,
        "role": "quantity"
      }
    ],
    "model": {
      "constants": [],
      "derived": [
        {
          "id": "ar",
          "expr": "alpha * pi / 180",
          "unit": "rad",
          "label": "Angle en radians"
        },
        {
          "id": "ca",
          "expr": "cos(ar)",
          "unit": "",
          "label": "Cosinus de l'angle"
        },
        {
          "id": "sa",
          "expr": "sin(ar)",
          "unit": "",
          "label": "Sinus de l'angle"
        },
        {
          "id": "cx",
          "expr": "-5.2 + 4.9 * ca - 0.6 * sa",
          "unit": "",
          "label": "Abscisse du bloc"
        },
        {
          "id": "cy",
          "expr": "-3 + 4.9 * sa + 0.6 * ca",
          "unit": "",
          "label": "Ordonnée du bloc"
        }
      ]
    },
    "scenes": [
