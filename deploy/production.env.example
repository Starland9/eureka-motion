DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
LLM_API_KEY=
RATE_LIMIT_SALT=

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_TRIAGE=deepseek-flash
LLM_MODEL_AUTHOR=deepseek-flash
LLM_MODEL_CHECKER=deepseek-flash
LLM_MODEL_JUDGE=deepseek-v4-pro

KOKORO_BASE_URL=
KOKORO_API_KEY=
KOKORO_VOICE_FR=ff_siwis
KOKORO_VOICE_EN=af_heart

# Pocket TTS: add `pocket` to TTS_PROVIDERS and set COMPOSE_PROFILES=pocket to start voice-pocket.
# docker-compose.yml fixes POCKET_BASE_URL for web.
# COMPOSE_PROFILES=pocket
# POCKET_BASE_URL=http://voice-pocket:8890
# POCKET_VOICE_FR=estelle
# POCKET_VOICE_EN=alba

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral

TTS_PROVIDERS=azure,kokoro
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_EXPORT_PER_HOUR=5
TRUSTED_PROXY_HOPS=1

DEEP=on
CLEANUP=on

WORKER_CPUS=3
WORKER_MEMORY=3g
