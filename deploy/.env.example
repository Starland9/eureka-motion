DATABASE_URL=postgresql://eureka:eureka@127.0.0.1:54329/eureka

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

LLM_MODEL_TRIAGE=deepseek-flash
LLM_MODEL_AUTHOR=deepseek-flash
LLM_MODEL_CHECKER=deepseek-flash
LLM_MODEL_JUDGE=deepseek-v4-pro

LLM_THINKING_TRIAGE=off
LLM_THINKING_AUTHOR=off
LLM_THINKING_CHECKER=off
LLM_THINKING_JUDGE=off

LLM_JUDGE_PROVIDER=
LLM_JUDGE_BASE_URL=
LLM_JUDGE_API_KEY=

# assemblyai, azure, deepgram, kokoro, pocket or none, tried in this order
TTS_PROVIDERS=azure,kokoro

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral
AZURE_VOICE_FR=fr-FR-DeniseNeural
AZURE_VOICE_EN=en-US-JennyNeural

# Deepgram Aura-2: add `deepgram` to TTS_PROVIDERS (first, e.g. deepgram,pocket) and set the key.
# DEEPGRAM_API_KEY=
# DEEPGRAM_HOST=https://api.eu.deepgram.com
# DEEPGRAM_VOICE_FR=aura-2-agathe-fr
# DEEPGRAM_VOICE_EN=aura-2-thalia-en
# DEEPGRAM_CONCURRENCY=10
# DEEPGRAM_TIMEOUT_MS=10000
# Integer of at least 1; anything else keeps the default.
# DEEPGRAM_MAX_ACTIVE=6

# AssemblyAI: add `assemblyai` to TTS_PROVIDERS (first, e.g. assemblyai,pocket) and set the key.
# ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_VOICE_FR=aai-donatien
# ASSEMBLYAI_VOICE_EN=aai-kyla
# ASSEMBLYAI_TTS_HOST=https://tts.eu.assemblyai.com
# ASSEMBLYAI_PER_MINUTE=45
# ASSEMBLYAI_MAX_WAIT_MS=10000
# Integer of at least 1; anything else keeps the default.
# ASSEMBLYAI_MAX_ACTIVE=2

KOKORO_BASE_URL=http://127.0.0.1:8880
KOKORO_VOICE_FR=ff_siwis
KOKORO_VOICE_EN=af_heart

# POCKET_BASE_URL=http://127.0.0.1:8890
# POCKET_VOICE_FR=estelle
# POCKET_VOICE_EN=alba

MEDIA_DIR=./media
SANDBOX_DIR=./sandbox

DEEP=on
CLEANUP=on
BROWSER_EXECUTABLE=

RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_EXPORT_PER_HOUR=5
RATE_LIMIT_SALT=

PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
