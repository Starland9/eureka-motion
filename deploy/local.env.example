# Copy to deploy/local.env (ignored by git). No real key is needed to play the references and
# to export a video; a free question needs LLM_API_KEY and the voice needs its own settings.
DATABASE_URL=postgresql://eureka:eureka@db:5432/eureka
LLM_API_KEY=unused
RATE_LIMIT_SALT=local
TTS_PROVIDERS=none
