    "version": 1,
    "plan": {
      "objective": "Explain how the equilibrium price and quantity of a market emerge from the crossing of a downward-sloping demand curve and an upward-sloping supply curve, and predict how they shift when a parameter changes.",
      "prerequisites": [
        "Reading a graph with price on the vertical axis and quantity on the horizontal axis",
        "Linear functions and their slope",
        "Solving a two-equation system by substitution"
      ],
      "analogy": {
        "name": "The seesaw of buyers and sellers",
        "mapping": "Each buyer pushes the price down when it is too high, each seller pushes it up when it is too low; the price settles where the two pushes balance, like a seesaw coming to rest."
      },
      "key_rule": {
        "statement": "The price settles where the quantity buyers want equals the quantity sellers offer; above it there is a surplus that pushes the price down, below it a shortage that pushes it up.",
        "formula": "\\q{Q_d} = a - b\\,\\q{P} \\quad,\\quad \\q{Q_s} = c + d\\,\\q{P} \\quad,\\quad a - b\\,\\res{P^*} = c + d\\,\\res{P^*}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Show a real price that moves on its own without anyone deciding it.",
          "visual": "A market stall: unsold tomatoes pile up, the price tag drops from 3 to 2, buyers rush in."
        },
        {
          "role": "analogy",
          "intent": "Give the intuition of two opposing pushes meeting at one resting point.",
          "visual": "A seesaw with a buyer’s weight on one side and a seller’s on the other, tilting until it levels."
        },
        {
          "role": "mechanism",
          "intent": "Show step by step how surplus and shortage push the price toward the crossing.",
          "visual": "Two curves drawn; a high price bar drops, a low one rises, arrows shrink as they near the crossing."
        },
        {
          "role": "formula",
          "intent": "Tie each symbol of the two linear equations to the curves just seen.",
          "visual": "The two equations write themselves; the crossing point lights up with its coordinates."
        },
        {
          "role": "example",
          "intent": "Compute a real equilibrium and show a surprising near-doubling when demand doubles.",
          "visual": "Sliders move: the demand curve slides right and the crossing jumps up and right, numbers update."
        },
        {
          "role": "recap",
          "intent": "Fix the three ideas and answer the hook about the tomato price.",
          "visual": "Three short lines appear one by one; the equilibrium point pulses on the graph."
        }
      ]
    },
