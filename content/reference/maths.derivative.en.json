    "plan": {
      "objective": "You will be able to explain that a derivative measures an instantaneous rate of change and compute it as the slope of the tangent line.",
      "prerequisites": [
        "Slope of a line: rise over run",
        "Reading a graph of a function",
        "Idea of an average rate of change"
      ],
      "analogy": {
        "name": "Speedometer in a car",
        "mapping": "The car’s position over time is the function; the average speed over a trip is the average rate of change; the speedometer at one instant is the derivative."
      },
      "key_rule": {
        "statement": "The derivative of a function at a point is the slope of the tangent line to its graph at that point, i.e. the instantaneous rate of change.",
        "formula": "\\a{f'(x)} = \\lim_{\\q{h} \\to 0} \\dfrac{f(x+\\q{h}) - f(x)}{\\q{h}}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Show a car’s distance curve and ask how fast it goes at one instant.",
          "visual": "A car moves along a road; its distance-time curve is drawn simultaneously; a question mark appears at a specific time."
        },
        {
          "role": "analogy",
          "intent": "Connect average speed between two instants to the slope of a secant line.",
          "visual": "Two points on a curve; a secant line is drawn between them; as the second point slides closer, the secant line rotates."
        },
        {
          "role": "mechanism",
          "intent": "Show that letting the interval shrink to zero gives the tangent line and its slope.",
          "visual": "The second point slides toward the first; the secant line approaches a fixed line, the tangent; slopes are displayed live."
        },
        {
          "role": "formula",
          "intent": "Write the limit definition and relate each symbol to the shrinking interval.",
          "visual": "The formula appears with colored symbols; h is highlighted and its value is animated from a large number to 0.001."
        },
        {
          "role": "example",
          "intent": "Compute the derivative of f(x)=x^2 at a point using the limit definition, showing a surprising number.",
          "visual": "The parabola y=x^2 is drawn; a tangent line is drawn at x=2; the slope value 4 is displayed, then x=3 gives 6, showing the doubling."
        },
        {
          "role": "recap",
          "intent": "Summarize that derivative = instantaneous rate of change = slope of tangent, and answer the hook question.",
          "visual": "Three key phrases appear; the car’s speedometer shows the instantaneous speed from the distance curve."
        }
      ]
