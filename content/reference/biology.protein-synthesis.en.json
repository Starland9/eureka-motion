  "payload": {
    "version": 1,
    "plan": {
      "objective": "Explain how the information in DNA is copied into mRNA and then translated into a protein, and why the base sequence matters.",
      "prerequisites": [
        "DNA is a double helix made of four bases (A, T, C, G)",
        "Proteins are chains of amino acids",
        "The cell contains a nucleus and ribosomes"
      ],
      "analogy": {
        "name": "A recipe in a locked library",
        "mapping": "DNA is the precious cookbook that never leaves the library (nucleus); mRNA is a photocopy of one recipe carried to the kitchen (ribosome); the protein is the cake you bake following that copy."
      },
      "key_rule": {
        "statement": "The base sequence of DNA is copied into mRNA, and each three-base codon of mRNA specifies one amino acid in the protein.",
        "formula": "\\q{\\text{DNA}} \\xrightarrow{\\text{transcription}} \\q{\\text{mRNA}} \\xrightarrow{\\text{translation}} \\res{\\text{protein}}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Show that a skin cell and a muscle cell look different yet contain the same DNA, raising the question of how DNA directs building proteins.",
          "visual": "Two cells side by side, one skin cell and one muscle cell, both with identical DNA strands inside, then a protein molecule appears only in the muscle cell."
        },
        {
          "role": "analogy",
          "intent": "Introduce the idea of copying information to protect the original and carry it to where it is needed.",
          "visual": "A cookbook locked in a glass case; a hand photocopies one page, the copy travels to a kitchen, and a cake is baked following the copy."
        },
        {
          "role": "mechanism",
          "intent": "Show transcription: RNA polymerase unzips DNA and builds a complementary mRNA strand.",
          "visual": "DNA double helix unzips; free RNA nucleotides pair with the exposed bases (A with U, T with A, C with G, G with C) and link into an mRNA strand that peels away."
        },
        {
          "role": "mechanism",
          "intent": "Show translation: the ribosome reads each codon and a tRNA brings the matching amino acid, forming a chain.",
          "visual": "mRNA attaches to a ribosome; tRNAs with anticodons enter, deposit amino acids, and the growing chain of amino acids folds into a protein."
        },
        {
          "role": "formula",
          "intent": "Connect the base sequence to the amino acid sequence using the codon table.",
          "visual": "A chart shows the 64 codons and their amino acids; one codon (AUG) is highlighted and the corresponding amino acid (methionine) is shown."
        },
        {
          "role": "example",
          "intent": "Give a concrete example: a gene of a known length produces a protein of a predictable number of amino acids.",
          "visual": "A gene of 300 base pairs is transcribed into a 300-base mRNA; the ribosome reads it in codons, producing a chain of 100 amino acids."
        },
        {
          "role": "recap",
          "intent": "Summarize the two steps and answer the hook: different cells express different genes, so they make different proteins.",
          "visual": "Two panels: transcription (DNA to mRNA) and translation (mRNA to protein); the skin cell and muscle cell now show different proteins, with the muscle cell’s protein highlighted."
        }
      ]
    },
    "params": [
      {
