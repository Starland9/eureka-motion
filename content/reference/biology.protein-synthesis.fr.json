    "plan": {
      "objective": "Expliquer que l’information de l’ADN est copiée en ARN messager puis traduite en une suite d’acides aminés, et savoir utiliser le code génétique pour lire un codon.",
      "prerequisites": [
        "Savoir que l’ADN est une double hélice de nucléotides A, T, G, C",
        "Savoir qu’une protéine est une chaîne d’acides aminés",
        "Savoir lire un triplet de lettres dans un tableau"
      ],
      "analogy": {
        "name": "La recette recopiée puis cuisinée",
        "mapping": "Le livre de recettes impossible à sortir de la cuisine joue le rôle de l’ADN ; la fiche recopiée qu’on emporte joue le rôle de l’ARNm ; les ingrédients ajoutés dans l’ordre jouent le rôle des acides aminés assemblés par le ribosome."
      },
      "key_rule": {
        "statement": "L’ADN est transcrit en ARN messager dans le noyau, puis chaque triplet de l’ARNm (un codon) est traduit en un acide aminé par le ribosome, ce qui donne une chaîne d’acides aminés : la protéine.",
        "formula": "\\text{ADN} \\rightarrow \\text{ARNm} \\rightarrow \\text{protéine}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Faire sentir que l’ADN reste dans le noyau alors que la protéine est fabriquée ailleurs.",
          "visual": "Le noyau avec son ADN, puis un ribosome au-dehors qui assemble une chaîne ; une seule molécule traverse, pas l’ADN."
        },
        {
          "role": "analogy",
          "intent": "Donner l’intuition d’une copie transportable d’une information intouchable.",
          "visual": "Un grand livre reste posé ; la fiche recopiée sort, et les ingrédients s’alignent un à un sur le comptoir."
        },
        {
          "role": "mechanism",
          "intent": "Montrer la transcription : une enzyme ouvre l’ADN et pose les nucléotides complémentaires de l’ARNm.",
          "visual": "La double hélice s’ouvre ; un brin d’ARNm se construit lettre par lettre, A avec U, C avec G."
        },
        {
          "role": "mechanism",
          "intent": "Montrer la traduction : le ribosome lit chaque codon et choisit l’acide aminé correspondant.",
          "visual": "Le ribosome glisse le long de l’ARNm ; à chaque triplet, un acide aminé s’accroche à la chaîne qui s’allonge."
        },
        {
          "role": "example",
          "intent": "Lire un vrai codon et observer qu’un changement de lettre peut suffire à changer ou arrêter la protéine.",
          "visual": "Le codon est lu dans le tableau : un acide aminé apparaît ; la dernière lettre change, la chaîne s’arrête."
        },
        {
          "role": "recap",
          "intent": "Fixer les trois étapes et répondre à la question de départ.",
          "visual": "Trois mots reliés par deux flèches ; l’ARNm en surbrillance traverse le noyau puis la porte du ribosome."
        }
      ]
    },
