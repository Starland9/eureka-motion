  "payload": {
    "version": 1,
    "plan": {
      "objective": "Explain how interest added to the capital then earns interest itself, and predict a balance with the formula B = C(1+r)^n.",
      "prerequisites": [
        "Percentages: taking 5% of a number",
        "Powers with a whole-number exponent",
        "Multiplying a number by a repeated factor"
      ],
      "analogy": {
        "name": "The snowball rolling downhill",
        "mapping": "The snowball is the balance, the fresh snow it picks up each turn is the interest, and each roll is one year: the bigger the ball, the more snow it grabs, so growth speeds up."
      },
      "key_rule": {
        "statement": "Each year the interest is calculated on the whole balance, capital plus interest already earned, so the balance is multiplied by the same factor (1 + rate) every period.",
        "formula": "\\res{B} = \\q{C} \\times (1 + \\q{r})^{\\q{n}}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Show two savers with the same start where one pulls far ahead, and ask why.",
          "visual": "Two bars grow year by year: the plain one rises in equal steps, the other bends upward and overtakes."
        },
        {
          "role": "analogy",
          "intent": "Give the feel that growth on growth accelerates, like a snowball.",
          "visual": "A snowball rolls down a slope, each turn it grows and sweeps up more snow; its radius curve steepens."
        },
        {
          "role": "mechanism",
          "intent": "Show that interest is computed on the new balance, not only on the starting capital.",
          "visual": "A stack of coins: 100, then 5% added on top, next year the 5% is taken from the whole new stack."
        },
        {
          "role": "formula",
          "intent": "Turn the repeated multiplication into one power and name each symbol.",
          "visual": "The factor (1+r) is stamped year after year on the balance; the stamps collapse into an exponent n."
        },
        {
          "role": "example",
          "intent": "Compute a real case and reveal how much of the final sum is interest.",
          "visual": "Table of balances year by year for the default values; the interest part grows faster than the deposits."
        },
        {
          "role": "recap",
          "intent": "Fix the two ideas and answer the hook.",
          "visual": "Three short lines; the last one highlights the curved bar from the hook."
        }
      ]
    },
