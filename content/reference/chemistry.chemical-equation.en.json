  "payload": {
    "version": 1,
    "plan": {
      "objective": "Balance a simple chemical equation by counting atoms and adding coefficients, knowing that the number of atoms of each element stays the same.",
      "prerequisites": [
        "Reading a chemical formula: H₂O means two hydrogen atoms and one oxygen atom",
        "Knowing that atoms are not created or destroyed",
        "Multiplying a small whole number by a group"
      ],
      "analogy": {
        "name": "A bicycle factory",
        "mapping": "Frames and wheels are atoms; a bicycle is a molecule; the factory floor is the equation, where you can order more frames or wheels but never change what a wheel is."
      },
      "key_rule": {
        "statement": "In a balanced equation the number of atoms of each element is the same before and after the reaction; you balance by putting whole numbers (coefficients) in front of the formulas, never by changing the formulas.",
        "formula": "\\q{\\text{H}_2} + \\q{\\text{O}_2} \\rightarrow \\q{\\text{H}_2\\text{O}} \\;\\text{with coefficients so that H and O counts match}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Show a burning reaction and ask why the equation as written seems to lose atoms.",
          "visual": "A candle burns; the labels H₂ + O₂ → H₂O appear, then a counter shows oxygen atoms vanishing."
        },
        {
          "role": "analogy",
          "intent": "Make the balance intuitive with parts that cannot appear or disappear.",
          "visual": "A factory floor: frames and wheels on the left, bicycles on the right; wheels pile up and a red 'shortage' flashes."
        },
        {
          "role": "mechanism",
          "intent": "Count atoms and add a coefficient to fix one element at a time.",
          "visual": "A coefficient slider changes the number in front of H₂O; the H and O counters update and the O counter turns from red to green."
        },
        {
          "role": "formula",
          "intent": "State the balancing rule: same count per element, coefficients only.",
          "visual": "The rule appears; a crossed-out H₂O → H₂O₂ shows you must not change subscripts."
        },
        {
          "role": "example",
          "intent": "Walk through H₂ + O₂ → H₂O with real counts and show the surprising result.",
          "visual": "Counters: 2 H and 2 O on the left, 2 H and 1 O on the right, then doubling water gives 4 H and 2 O, so hydrogen also must be doubled."
        },
        {
          "role": "recap",
          "intent": "Fix the two ideas and answer the hook: atoms are conserved, coefficients balance them.",
          "visual": "Two short lines, then the balanced equation 2H₂ + O₂ → 2H₂O lights up with all counters equal."
        }
      ]
    },
