    "plan": {
      "objective": "Savoir calculer un capital placé à intérêts composés avec la formule C × (1 + i)^n et expliquer pourquoi la croissance s’accélère.",
      "prerequisites": [
        "Savoir calculer un pourcentage d’une quantité",
        "Savoir élever un nombre à une puissance entière",
        "Comprendre qu’une suite de multiplications répétées fait grossir vite"
      ],
      "analogy": {
        "name": "La boule de neige qui roule",
        "mapping": "La neige collée à chaque tour joue le rôle des intérêts ; plus la boule grossit, plus elle ramasse de neige au tour suivant, comme un capital plus gros rapporte plus d’intérêts."
      },
      "key_rule": {
        "statement": "Chaque année, les intérêts s’ajoutent au capital et rapportent eux aussi des intérêts l’année suivante : après n années, le capital est multiplié n fois par (1 + i).",
        "formula": "\\res{C_n} = \\q{C_0} \\times (1 + \\q{i})^{\\q{n}}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Faire sentir qu’un même taux donne des gains qui grossissent sans qu’on ajoute d’argent.",
          "visual": "Deux compteurs côte à côte : gains d’intérêts simples fixes, gains composés qui grimpent de plus en plus."
        },
        {
          "role": "analogy",
          "intent": "Donner l’intuition d’une croissance qui s’entretient elle-même.",
          "visual": "Une boule de neige roule et grossit ; à chaque tour elle ramasse une couche plus épaisse."
        },
        {
          "role": "mechanism",
          "intent": "Dérouler année par année l’ajout des intérêts au capital.",
          "visual": "Trois barres empilées an 1, an 2, an 3 : la part des intérêts s’ajoute au capital et grandit."
        },
        {
          "role": "formula",
          "intent": "Relier la formule aux multiplications successives vues à l’étape précédente.",
          "visual": "La formule s’écrit ; le taux varie et la courbe se redessine en direct."
