  "payload": {
    "version": 1,
    "plan": {
      "objective": "You will be able to state Newton’s law of universal gravitation and say how the force between two masses changes when a mass or the distance changes.",
      "prerequisites": [
        "A force is a vector, drawn as an arrow with a direction and a length",
        "Mass in kilograms, and the difference between mass and weight",
        "Squaring a number, and powers of ten"
      ],
      "analogy": {
        "name": "The paint sprayer",
        "mapping": "The sprayer plays the role of the attracting mass, the paint landing on a small square plays the role of the force, and moving the square further away plays the role of increasing the distance. Twice as far, the same paint covers four small squares, so each one gets a quarter."
      },
      "key_rule": {
        "statement": "Two masses attract each other with a force proportional to the product of their masses and inversely proportional to the square of the distance between their centres, along the line joining them.",
        "formula": "\\a{F} = G \\, \\dfrac{\\q{m_1} \\, \\q{m_2}}{\\q{r}^2}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Make the student wonder how a force can act across empty space, with no string and no contact.",
          "visual": "On the left a ball is dropped and falls; on the right the Moon circles the Earth and never flies off; both are drawn together."
        },
        {
          "role": "analogy",
          "intent": "Give the intuition that an effect spreading out in all directions fades like the square of the distance.",
          "visual": "A sprayer sends paint outward; a small square slides from 1 to 2 to 3 metres and the paint it catches shrinks to a quarter, then a ninth."
        },
        {
          "role": "mechanism",
          "intent": "Show that the pull is mutual and that its length changes with distance.",
          "visual": "Earth and Moon with two equal, opposite arrows; the Moon slides away and both arrows shrink in step."
        },
        {
          "role": "formula",
          "intent": "Attach each symbol of Newton’s law to what was just seen: masses in the numerator, distance squared below.",
          "visual": "The formula writes itself symbol by symbol; then r slides and the arrow length on screen follows the value live."
        },
        {
          "role": "example",
          "intent": "Give a real order of magnitude and show how fast the pull collapses with distance.",
          "visual": "Bars for the Earth-Moon force at the real distance, at double and at triple distance, shrinking to a quarter and a ninth."
        },
        {
          "role": "recap",
          "intent": "Fix the two or three ideas and answer the hook: gravity is the string that never touches.",
          "visual": "Three short lines appear; the last one, the answer about the Moon, is highlighted and the Moon’s arrow pulses."
        }
      ]
    },
