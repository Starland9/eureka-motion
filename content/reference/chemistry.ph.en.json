  "payload": {
    "version": 1,
    "plan": {
      "objective": "Explain what pH measures, why the scale is logarithmic, and how one unit of pH corresponds to a factor of ten in the concentration of H⁺ ions.",
      "prerequisites": [
        "Powers of ten and scientific notation",
        "The logarithm base 10 as 'which exponent of 10 gives this number'",
        "Concentration in mol/L"
      ],
      "analogy": {
        "name": "The staircase of tens",
        "mapping": "Each step up the staircase multiplies the number of H⁺ ions per litre by ten, like a staircase where each step is ten times higher than the one before; a step down divides by ten."
      },
      "key_rule": {
        "statement": "The pH is the opposite of the base-10 logarithm of the concentration of H⁺ ions in mol/L: each unit of pH means the concentration changes by a factor of ten.",
        "formula": "\\mathrm{pH} = -\\log_{10}\\left(\\q{[\\mathrm{H^+}]}\\right)"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Show that lemon juice and vinegar have close pH values, then ask what that number really counts.",
          "visual": "Two beakers labelled lemon and vinegar; a pH meter needle slides to 2 and to 3; a question mark grows over the gap."
        },
        {
          "role": "analogy",
          "intent": "Give the intuition of a scale where each step is a multiplication, not an addition.",
          "visual": "A staircase of tens: each step up makes a column of dots ten times taller, going 1, 10, 100, 1000."
        },
        {
          "role": "mechanism",
          "intent": "Show that pH counts the H⁺ ions per litre and turns a tiny number into a handy one.",
          "visual": "A litre box fills with H⁺ dots; the count drops from 10⁻² to 10⁻³; the pH number rises from 2 to 3 as the dots thin out."
        },
        {
          "role": "formula",
          "intent": "Tie each symbol of the formula to the dots and the exponent just seen.",
          "visual": "The formula writes itself; the concentration is dragged along a power-of-ten axis and the pH value follows live."
        },
        {
          "role": "example",
          "intent": "Compute a real case and reveal the surprising factor of ten between pH 2 and pH 3.",
          "visual": "Lemon at pH 2 with 10⁻² mol/L, vinegar at pH 3 with 10⁻³ mol/L; a bar of ions shrinks by ten between them."
        },
        {
          "role": "recap",
          "intent": "Fix the three ideas and answer the hook: pH 2 and pH 3 differ by a factor of ten in H⁺.",
          "visual": "Three short lines appear; the last one, the answer, is highlighted while the ion bar shrinks."
        }
      ]
    },
