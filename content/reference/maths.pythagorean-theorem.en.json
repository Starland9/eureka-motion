    "plan": {
      "objective": "You will be able to state the Pythagorean theorem, see why it is true with squares on the sides, and use it to find a missing side of a right triangle.",
      "prerequisites": [
        "Right angle and right triangle",
        "Area of a square (side × side)",
        "Squaring a number"
      ],
      "analogy": {
        "name": "Two small pizzas vs one big pizza",
        "mapping": "The two short sides of the right triangle are the two small squares; the long side is the big square. The theorem says the two small squares together have exactly the area of the big one."
      },
      "key_rule": {
        "statement": "In a right triangle, the squares built on the two short sides, added together, have exactly the same area as the square built on the longest side.",
        "formula": "\\q{a}^2 + \\q{b}^2 = \\res{c}^2"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Show a right triangle with squares on its sides and ask why the two small areas match the big one.",
          "visual": "A right triangle, then three squares grow outward from its sides; the two small squares slide and fill the big square exactly."
        },
        {
          "role": "analogy",
          "intent": "Give the intuition that two smaller areas can exactly equal one bigger area.",
          "visual": "Two small pizzas slide together, then a big pizza appears; a balance scale tips to show equal area."
        },
        {
          "role": "mechanism",
          "intent": "Show step by step that the two small squares are made of the same pieces as the big square.",
          "visual": "The big square is cut into two small squares and four copies of the triangle; pieces fly apart and reassemble."
        },
        {
          "role": "formula",
          "intent": "Connect the side lengths to the areas with the formula a² + b² = c².",
          "visual": "The letters a, b, c appear on the sides; squares are labeled a², b², c²; the formula writes itself with the numbers changing as a and b change."
        },
        {
          "role": "example",
          "intent": "Work a concrete example: legs 3 and 4 give hypotenuse 5, and see a surprising number when one leg is doubled.",
          "visual": "A 3-4-5 triangle with squares of areas 9, 16, 25; then the leg 3 is stretched to 6, the squares grow, and the new hypotenuse is computed live."
        },
        {
          "role": "recap",
          "intent": "Recall that the two small squares add up to the big one, answer the hook, and emphasize that only right triangles obey it.",
          "visual": "Three short sentences appear; the last one is highlighted, and a non-right triangle makes the big square slightly larger than the sum of the two small ones."
        }
      ]
