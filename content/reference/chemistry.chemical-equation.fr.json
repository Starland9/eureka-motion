    "plan": {
      "objective": "Savoir équilibrer une équation chimique en ajustant les coefficients pour que chaque type d’atome soit identique des deux côtés.",
      "prerequisites": [
        "Reconnaître les formules des molécules simples (H₂, O₂, H₂O)",
        "Lire un indice dans une formule (le 2 de H₂O)",
        "Compter des objets identiques de part et d’autre"
      ],
      "analogy": {
        "name": "La recette des crêpes",
        "mapping": "Les atomes sont les ingrédients : on peut doubler la quantité de pâte, mais il faut garder les mêmes proportions, sinon il reste des œufs sur la table."
      },
      "key_rule": {
        "statement": "Une équation est équilibrée quand le nombre d’atomes de chaque élément est le même dans les réactifs et dans les produits ; on y arrive en changeant seulement les coefficients devant les formules, jamais les indices.",
        "formula": "\\q{a}\\,\\mathrm{A} + \\q{b}\\,\\mathrm{B} \\rightarrow \\res{c}\\,\\mathrm{AB}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Faire voir qu’une équation écrite au hasard ne compte pas pareil des deux côtés.",
          "visual": "Formule H₂ + O₂ vers H₂O ; les atomes d’oxygène sont comptés à gauche et à droite, deux contre un."
        },
        {
          "role": "analogy",
          "intent": "Faire sentir qu’on peut tout agrandir tant que les proportions sont gardées.",
          "visual": "Deux bols de pâte : un seul, puis doublé ; les œufs restent appariés aux farines."
        },
        {
          "role": "mechanism",
          "intent": "Montrer qu’on ajuste les coefficients un par un jusqu’à l’égalité des atomes.",
          "visual": "Les boules H et O glissent d’un plateau à l’autre ; le coefficient 2 apparaît devant H₂O et rééquilibre."
        },
        {
          "role": "formula",
          "intent": "Énoncer la règle du comptage et l’interdiction de toucher aux indices.",
          "visual": "Les comptages de H et O s’affichent en deux colonnes et passent au vert quand ils sont égaux."
        },
        {
          "role": "example",
          "intent": "Vérifier sur la combustion du méthane qu’un coefficient un peu plus grand suffit.",
          "visual": "CH₄ + 2 O₂ vers CO₂ + 2 H₂O ; chaque type d’atome est coché à gauche et à droite."
        },
        {
          "role": "recap",
          "intent": "Fixer les deux idées : compter chaque élément, ajuster les coefficients seulement.",
          "visual": "Deux phrases courtes, puis la formule H₂ + O₂ équilibrée en surbrillance."
        }
      ]
    },
