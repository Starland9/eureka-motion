  "payload": {
    "version": 1,
    "plan": {
      "objective": "Expliquer comment la rencontre de l’offre et de la demande fixe un prix d’équilibre, et pourquoi un prix trop haut ou trop bas se corrige de lui-même.",
      "prerequisites": [
        "Lire un graphique avec un axe des quantités et un axe des prix",
        "Savoir qu’une droite traduit une relation entre deux grandeurs",
        "Comprendre qu’un vendeur veut vendre cher et un acheteur acheter bon marché"
      ],
      "analogy": {
        "name": "La bourse d’échange de cartes",
        "mapping": "Les élèves qui vendent des cartes sont l’offre, ceux qui en cherchent sont la demande, et le prix auquel les échanges se font vraiment est le prix d’équilibre ; si le prix affiché est trop haut, des cartes restent invendues et le prix baisse."
      },
      "key_rule": {
        "statement": "Le prix d’équilibre est celui pour lequel la quantité offerte égale la quantité demandée ; au-dessus, il y a trop de marchandise et le prix baisse, en dessous, il en manque et le prix monte.",
        "formula": "\\q{p} \\;\\text{tel que}\\; \\res{Q_o}(\\q{p}) = \\res{Q_d}(\\q{p})"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Faire constater qu’un même objet n’a pas le même prix partout et au même moment, et se demander qui décide.",
          "visual": "Un billet de concert affiché à 40, 90 puis 250 euros selon le jour ; le prix s’anime et grimpe."
        },
        {
          "role": "analogy",
          "intent": "Faire vivre la rencontre entre vendeurs et acheteurs autour d’un prix affiché.",
          "visual": "Des élèves autour d’une table ; le prix affiché change et le nombre de cartes offertes et demandées bouge en sens inverse."
        },
        {
          "role": "mechanism",
          "intent": "Montrer que l’offre monte et la demande descend quand le prix augmente.",
          "visual": "Deux courbes se tracent : la demande descend, l’offre monte ; un point de croisement apparaît."
        },
        {
          "role": "formula",
          "intent": "Nommer le point de croisement : le prix d’équilibre, et lire sa valeur sur le graphique.",
          "visual": "Le curseur du prix glisse ; à la verticale du croisement, quantité offerte et quantité demandée s’alignent."
        },
        {
          "role": "example",
          "intent": "Vérifier sur des nombres qu’un prix trop haut laisse un surplus et qu’un prix trop bas crée une pénurie.",
          "visual": "À 8 euros, 60 objets offerts mais 20 demandés : les invendus s’empilent ; à 2 euros, la file d’acheteurs s’allonge."
        },
        {
          "role": "recap",
          "intent": "Fixer les trois idées et répondre à la question du billet de concert.",
          "visual": "Trois phrases courtes ; la dernière, la réponse, est surlignée pendant que le prix se stabilise."
        }
      ]
    },
