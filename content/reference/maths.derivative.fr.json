    "plan": {
      "objective": "Savoir que la dérivée d’une fonction en un point est la pente de la tangente, et qu’elle mesure la vitesse de variation.",
      "prerequisites": [
        "Lire un graphique : abscisse, ordonnée",
        "Calculer un coefficient directeur avec (y₂−y₁)/(x₂−x₁)",
        "Notion de fonction"
      ],
      "analogy": {
        "name": "Le compteur de vitesse",
        "mapping": "La position en fonction du temps joue le rôle de la courbe ; la vitesse affichée sur le compteur joue le rôle de la dérivée à cet instant ; une portion raide est une vitesse élevée."
      },
      "key_rule": {
        "statement": "La dérivée de f en a est le coefficient directeur de la tangente à la courbe au point d’abscisse a ; c’est la limite du taux de variation quand h tend vers 0.",
        "formula": "f'(\\q{a}) = \\lim_{h \\to 0} \\dfrac{f(\\q{a}+h) - f(\\q{a})}{h}"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Faire remarquer que la vitesse affichée change tout le temps, et se demander laquelle choisir.",
          "visual": "Une voiture roule, le compteur grimpe puis redescend ; la question « vitesse à l’instant t ? » clignote."
        },
        {
          "role": "analogy",
          "intent": "Faire sentir qu’on peut parler de vitesse à un instant précis, pas seulement en moyenne.",
          "visual": "Le trajet dessiné sur une carte avec deux bornes ; le chrono entre les bornes donne la vitesse moyenne, le compteur donne l’instantané."
        },
        {
          "role": "mechanism",
          "intent": "Montrer la corde entre deux points qui se rapproche de la tangente quand h rétrécit.",
          "visual": "Sur la courbe, le point B glisse vers A ; la corde AB pivote et devient la tangente."
        },
        {
          "role": "formula",
          "intent": "Nommer le taux de variation et sa limite, et relier h à zéro.",
          "visual": "La formule s’écrit ; h rétrécit en direct et la valeur du quotient se stabilise sur un nombre."
        },
        {
          "role": "example",
          "intent": "Calculer une dérivée sur un cas simple et faire apparaître un résultat contre-intuitif.",
          "visual": "La parabole y = x², tangente en x = 1, pente 2 ; le curseur s’éloigne et la pente double."
        },
        {
          "role": "recap",
          "intent": "Fixer les trois idées : pente de la tangente, limite du taux de variation, vitesse instantanée.",
          "visual": "Trois phrases courtes ; la dernière répond à la question du compteur, surlignée."
        }
      ]
    },
