          "prompt": "You search a sorted array by comparing the target with the middle element and keeping only the half that could still contain it. What happens to the size of the remaining search interval after each comparison?",
          "choices": [
            {
              "id": "a",
              "text": "It decreases by one element"
            },
            {
              "id": "b",
              "text": "It roughly halves"
            },
