        "default": 1024,
        "role": "quantity"
      }
    ],
    "model": {
      "constants": [],
      "derived": [
        {
          "id": "L",
          "expr": "floor(log10(n)/log10(2)) + 1",
          "unit": "comparisons",
          "label": "Worst-case comparisons",
          "symbol": "L",
          "format": "int"
        },
        {
          "id": "L_half",
          "expr": "floor(log10(max(1,round(n/2)))/log10(2)) + 1",
          "unit": "comparisons",
          "label": "Worst case for half the elements",
          "symbol": "L(n/2)",
          "format": "int"
        },
        {
          "id": "L_double",
          "expr": "floor(log10(2*n)/log10(2)) + 1",
          "unit": "comparisons",
          "label": "Worst case for double the elements",
          "symbol": "L(2n)",
          "format": "int"
        },
        {
          "id": "ratio",
          "expr": "n / L",
          "unit": "elements per comparison",
          "label": "Elements handled per comparison",
          "symbol": "n/L",
          "format": "int"
        }
      ]
    },
