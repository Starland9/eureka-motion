  "payload": {
    "version": 1,
    "plan": {
      "objective": "Explain why binary search on a sorted array halves the search interval each step, and let you predict the worst-case number of comparisons for n elements.",
      "prerequisites": [
        "Sorted array and random access by index",
        "Floor and ceiling, and logarithms base 2",
        "Loop invariants: the target, if present, stays inside [lo, hi]"
      ],
      "analogy": {
        "name": "Guessing a number between 1 and 100",
        "mapping": "Each guess is a comparison at the midpoint; a 'higher' or 'lower' answer discards the half you no longer need, exactly as the algorithm discards half the index range."
      },
      "key_rule": {
        "statement": "Binary search compares the target with the middle element, then keeps only the half that can still contain it, so the interval length roughly halves each step and the worst case is logarithmic in n.",
        "formula": "L_{\\q{n}} = \\left\\lfloor \\log_2 \\q{n} \\right\\rfloor + 1"
      },
      "steps": [
        {
          "role": "hook",
          "intent": "Show a huge sorted list and ask how few checks could find one name.",
          "visual": "A column of 1024 sorted names; a hand points at one target, then the list shrinks as halves are greyed out."
        },
        {
          "role": "analogy",
          "intent": "Make halving feel natural through the guess-my-number game.",
          "visual": "A number line from 1 to 100; a marker jumps to 50, then 25 or 75, while the impossible half fades."
        },
        {
          "role": "mechanism",
          "intent": "Show the loop: compare with mid, then move lo or hi past mid.",
          "visual": "Array boxes with lo and hi arrows; mid lights up, one side is crossed out, arrows slide inward each iteration."
        },
        {
          "role": "formula",
          "intent": "Link the halving to a logarithm and give the exact worst-case count for this loop variant.",
          "visual": "The interval length n, n/2, n/4 is drawn as bars that shrink; the formula L = floor(log2 n) + 1 writes itself."
        },
        {
          "role": "example",
          "intent": "Let you predict and then check the count for a concrete n, with a surprising extra comparison.",
          "visual": "n = 8 boxes; each step greys half, and a counter ticks 1, 2, 3, 4 as the last single box is checked."
        },
        {
          "role": "recap",
          "intent": "Fix the halving, the log count and the answer to how few checks a huge list needs.",
          "visual": "Three short lines appear; the last one, the comparison count for the 1024-name list, is highlighted."
        }
      ]
    },
    "params": [
      {
        "id": "n",
        "symbol": "n",
