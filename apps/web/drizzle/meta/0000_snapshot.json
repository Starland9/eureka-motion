      "checkConstraints": {
        "explanations_id_format": {
          "name": "explanations_id_format",
          "value": "\"explanations\".\"id\" ~ '^[A-Za-z0-9_-]{12}$'"
        },
        "explanations_question_length": {
          "name": "explanations_question_length",
          "value": "char_length(\"explanations\".\"question\") between 1 and 500"
        },
        "explanations_parent_required": {
          "name": "explanations_parent_required",
          "value": "\"explanations\".\"kind\" in ('initial', 'reference') or \"explanations\".\"parent_id\" is not null"
        },
        "explanations_start_is_root": {
          "name": "explanations_start_is_root",
          "value": "\"explanations\".\"kind\" not in ('initial', 'reference') or \"explanations\".\"root_id\" = \"explanations\".\"id\""
        },
        "explanations_focus_only_for_zoom": {
          "name": "explanations_focus_only_for_zoom",
          "value": "\"explanations\".\"focus_scene_id\" is null or \"explanations\".\"kind\" = 'zoom'"
        },
        "explanations_scene_count": {
          "name": "explanations_scene_count",
          "value": "\"explanations\".\"scene_count_planned\" is null or (case when \"explanations\".\"kind\" in ('followup', 'zoom') then \"explanations\".\"scene_count_planned\" between 1 and 3 else \"explanations\".\"scene_count_planned\" between 4 and 7 end)"
        },
        "explanations_reference_no_expiry": {
          "name": "explanations_reference_no_expiry",
          "value": "\"explanations\".\"kind\" <> 'reference' or \"explanations\".\"expires_at\" is null"
        }
      },
