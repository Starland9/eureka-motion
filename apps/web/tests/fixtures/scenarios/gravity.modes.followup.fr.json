              "unit": "N",
              "label": "Force à distance double",
              "format": "sci:2"
            },
            {
              "id": "F_3r",
              "expr": "G * m1 * m2 / (3 * r)^2",
              "unit": "N",
              "label": "Force à distance triple",
              "format": "sci:2"
            }
          ]
        }
