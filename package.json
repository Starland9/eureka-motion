{
  "name": "eureka-motion",
  "version": "0.0.0",
  "private": true,
  "description": "Eureka Motion: animated concept explainers",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "snapshot": "pnpm --filter web exec tsx --tsconfig scripts/tsconfig.json scripts/snapshot.tsx",
    "reference:build": "pnpm --filter web exec tsx --tsconfig scripts/tsconfig.json ../../scripts/reference-build.ts",
    "reference:generate": "pnpm --filter web exec tsx --tsconfig scripts/tsconfig.json ../../scripts/reference-generate.ts",
    "db:generate": "pnpm --filter web exec drizzle-kit generate",
    "db:migrate": "pnpm --filter web exec drizzle-kit migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
